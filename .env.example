# Every environment variable LeadFlow reads, in one place.
# Copy the relevant lines into backend/.env and frontend/.env.local (see README).
# All values below are the defaults, so the app also runs with no .env files at all.

# --- Backend (backend/.env) ---
# SQLAlchemy connection string. The SQLite file is created on first start.
DATABASE_URL=sqlite:///./leadflow.db
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Key used to sign login tokens. Set a long random value outside local development.
SECRET_KEY=dev-only-secret-change-me-please-use-a-long-random-value
# How long a login stays valid, in minutes.
ACCESS_TOKEN_MINUTES=720
# Demo account created on first start when there are no users.
DEMO_EMAIL=demo@leadflow.test
DEMO_PASSWORD=leadflow123

# --- Frontend (frontend/.env.local) ---
# Base URL of the API. Inlined at build time (NEXT_PUBLIC_*).
NEXT_PUBLIC_API_URL=http://localhost:8000
